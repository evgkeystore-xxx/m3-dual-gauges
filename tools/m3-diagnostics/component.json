{
  "id": "m3-diagnostics",
  "kind": "tool",
  "version": "1.0.0",
  "title": "M3 Diagnostics",
  "description": "Read-only app startup logs, status and settings backup downloads on the local BMW hotspot, port 8484. No ECU operations.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID8"
  ],
  "files": [
    {
      "path": "diagnostics-server.js",
      "from": "diagnostics-server.js",
      "mode": "0644"
    },
    {
      "path": "index.html",
      "from": "index.html",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "m3-diagnostics.service",
      "from": "m3-diagnostics.service"
    }
  ],
  "enable": [
    {
      "unit": "m3-diagnostics.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "m3-diagnostics.service"
  ]
}
