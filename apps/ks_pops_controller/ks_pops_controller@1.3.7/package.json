{
  "name": "ks_pops_controller",
  "version": "1.3.7",
  "description": "Pops controller V4 | iDrive 8 | tabs Parametry/Wykresy/Silnik | demonstracja, bez ECU",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 31457280,
    "cpuLimit": 30,
    "memoryThresholdKB": 163840,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "POPS",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "assets",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSE.GPL3.txt"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "Independent project",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID8"
  ],
  "mguLocalOnly": true,
  "mguRequires": {
    "mgu-deploy": "0.7.5"
  }
}
