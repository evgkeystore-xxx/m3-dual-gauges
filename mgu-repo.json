{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "build": {
      "node": "tools/prebuilt.js",
      "output": "{dir}/{id}@{version}.tgz"
    },
    "uninstallable": true
  },
  "tools": [
    {
      "id": "m3-diagnostics",
      "path": "tools/m3-diagnostics"
    }
  ]
}
